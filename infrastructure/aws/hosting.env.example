# Copy to .runtime/aws/hosting.env and fill locally. Asterisks are placeholders.
AWS_PROFILE=secureops
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=********
PLATFORM_ENVIRONMENT=dev
PUBLIC_HOSTED_ZONE_ID=********
APPLICATION_DOMAIN=********
OPERATIONS_EMAIL=********
STATE_BUCKET_NAME=********
STATE_KMS_KEY_ARN=********
ANSIBLE_SSM_BUCKET=********
ANSIBLE_SSM_KMS_KEY=********
# Use the same generated token for Terraform and the Redis secret JSON.
TF_VAR_redis_auth_token=********
