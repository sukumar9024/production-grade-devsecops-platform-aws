[Unit]
Description=SecureOps production gateway
Requires=docker.service
After=docker.service network-online.target
ConditionPathExists={{ secureops_root }}/.env.runtime
ConditionPathExists={{ secureops_root }}/.runtime/gateway.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ secureops_root }}
EnvironmentFile={{ secureops_root }}/.runtime/gateway.env
ExecStart=/usr/bin/docker compose -p secureops-gateway -f compose.gateway.yaml up -d
ExecStop=/usr/bin/docker compose -p secureops-gateway -f compose.gateway.yaml stop
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
