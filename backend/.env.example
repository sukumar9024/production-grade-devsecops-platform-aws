APP_NAME=SecureOps API
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://secureops:generate-me@localhost:5432/secureops
REDIS_URL=redis://:generate-me@localhost:6379/0
# Generate a unique secret: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=generate-me-before-starting-the-application
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# TEST_DATABASE_URL must explicitly point to a disposable PostgreSQL database.
